#!/usr/bin/env python3
"""Extract one task's section from a plan into that plan's tasks/ folder.

Usage:  docs/superpowers/bin/task-brief <plan-dir> <task-number>

Layout this assumes, one folder per plan:

    docs/superpowers/plans/<YYYY-MM-DD-slug>/
        spec.md      the requirements
        plan.md      the tasks
        progress.md  the ledger
        tasks/       task-NN-brief.md and task-NN-report.md

The plan is the single source of task requirements. A brief is a derived
extract, so regenerate it whenever the plan changes rather than editing it -
if a brief and the plan disagree, the brief is stale.
"""
import re
import sys
from pathlib import Path


def main() -> int:
    if len(sys.argv) != 3:
        print(__doc__.strip(), file=sys.stderr)
        return 2

    plan_dir = Path(sys.argv[1])
    number = sys.argv[2]
    plan = plan_dir / "plan.md"

    if not plan.is_file():
        print(f"no plan.md in {plan_dir}", file=sys.stderr)
        return 1

    lines = plan.read_text().split("\n")

    # Global Constraints bind every task, so carry them into every brief -
    # an implementer sees only its own brief.
    constraints, in_constraints = [], False
    for line in lines:
        if line.startswith("## Global Constraints"):
            in_constraints = True
            continue
        if in_constraints:
            if line.startswith("---") or line.startswith("## "):
                break
            constraints.append(line)

    start = end = None
    heading = re.compile(rf"^### Task {re.escape(number)}: ")
    for i, line in enumerate(lines):
        if start is None and heading.match(line):
            start = i
            continue
        if start is not None and (
            re.match(r"^### Task \d+: ", line) or line.startswith("## ")
        ):
            end = i
            break
    if start is None:
        print(f"no Task {number} in {plan}", file=sys.stderr)
        return 1
    if end is None:
        end = len(lines)

    body = "\n".join(lines[start:end]).rstrip()
    out = plan_dir / "tasks" / f"task-{int(number):02d}-brief.md"
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(
        f"# Task {number} brief\n\n"
        f"Extracted from `{plan}`. Do not edit - regenerate if the plan changes.\n\n"
        f"## Global Constraints\n\n"
        f"These bind this task even where its steps do not repeat them.\n"
        + "\n".join(constraints).rstrip()
        + "\n\n---\n\n"
        + body
        + "\n"
    )
    print(out)
    return 0


if __name__ == "__main__":
    sys.exit(main())
