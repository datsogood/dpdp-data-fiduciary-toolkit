# Required - MongoDB connection string.
MONGO_URI=mongodb://localhost:27017/dpdp-toolkit

# Required - secret used to derive the lookup hash for a data principal's
# email and phone. Generate with: openssl rand -hex 32
# The toolkit refuses to start if this is unset or shorter than 32
# characters. Changing it orphans every existing principal lookup, so treat
# it as permanent once you have data. This file ships it EMPTY on purpose -
# there is no safe default for a secret - so fill it in before starting.
PRINCIPAL_ID_SECRET=

# Your organisation's identity, shown to data principals.
FIDUCIARY_NAME=Kavach Finance

# Grievance Officer / Data Protection Officer contact. The toolkit refuses
# to start if these are left at the example.com placeholder.
FIDUCIARY_DPO_NAME=Data Protection Officer
FIDUCIARY_DPO_EMAIL=dpo@example.com

# Days the Grievance Officer has to resolve a grievance before a data
# principal may escalate. Must be a positive integer.
GRIEVANCE_SLA_DAYS=7

# Days a rights request (Chapter III - access, correction, erasure,
# nomination) is expected to take. Must be a positive integer.
RIGHTS_SLA_DAYS=30

# Languages the Section 5 notice is available in. ONLY "en" IS SUPPORTED,
# and the toolkit refuses to start if you name anything else.
#
# This is not a placeholder waiting for configuration. There is no
# translation map in this package: every notice string comes from one
# English catalog, so naming another language here would produce an English
# notice LABELLED as that language, hashed, and cited by every consent event
# written under it - false evidence of Section 5(3) compliance on a ledger
# that cannot be edited. Section 5(3) does permit any Eighth Schedule
# language; supplying one is work an adopter has to do, not a setting.
NOTICE_LANGUAGES=en

# Example server only.
PORT=4000
